a')c.title=(text||'Imagem anexada').slice(0,45);c.updated=Date.now();$('prompt').value='';clearImage();save();render();go(c)}function go(c){let a={id:N(),role:'assistant',content:'',pending:1,created:Date.now()};c.messages.push(a);save();render();let msgs=c.messages.filter(x=>!x.pending).slice(-20).map(x=>{let o={role:x.role,content:x.content};if(x.image)o.images=[x.image.data];return o}),sys=[profiles[c.profile||cfg.profile][2],cfg.system,cfg.memory&&'Memória do usuário: '+cfg.memory].filter(Boolean).join('\n\n'),id='r'+N(),payload={model:cfg.model,messages:[{role:'system',content:sys},...msgs],stream:true,options:{temperature:+cfg.temp,num_ctx:+cfg.ctx}};req={id,c:c.id,m:a.id};$('send').classList.add('stop');$('send').textContent='■';V('chat',cfg.server,JSON.stringify(payload),id)}function finish(err){if(!req)return;let c=chats.find(x=>x.id==req.c),m=c?.messages.find(x=>x.id==req.m);if(m){m.pending=0;m.error=err||''}req=null;$('send').classList.remove('stop');$('send').textContent='➤';save();render()}
window.nativeCallbacks={serverVersion:(id,b)=>{let v='';try{v=JSON.parse(b).version}catch(e){}setStatus(1,'Conectado'+(v?' • '+v:''));V('listModels',cfg.server,'models')},models:(id,b)=>{try{models=JSON.parse(b).models||[];modelOptions();setStatus(1,models.length+' modelo(s) disponível(is)')}catch(e){setStatus(0,'Resposta inválida')}},chunk:(id,l)=>{if(!req||req.id!=id)return;try{let d=JSON.parse(l),c=chats.find(x=>x.id==req.c),m=c.messages.find(x=>x.id==req.m);m.content+=d.message?.content||d.response||'';render()}catch(e){}},done:id=>{if(req?.id==id)finish()},stopped:id=>{if(req?.id==id)finish('Resposta interrompida.')},error:(id,s)=>{if(req?.id==id)finish(s);else{setStatus(0,s);toast(s)}},voice:s=>{use(($('prompt').value+' '+s).trim())},image:(mime,data)=>{image={mime,data};$('attach').classList.add('show');$('attachImg').src=`data:${mime};base64,${data}`},imported:s=>importData(s),exported:s=>toast(s)};
function setStatus(ok,s){$('dot').className='dot '+(ok?'ok':'bad');$('status').textContent=s}function test(){setStatus(0,'Testando…');V('serverVersion',cfg.server,'test'+N())}function modelOptions(){let sel=$('model'),names=models.map(x=>x.name||x.model);sel.innerHTML='<option value="">Modelo</option>'+names.map(n=>`<option ${n==cfg.model?'selected':''}>${esc(n)}</option>`).join('');if(!cfg.model&&names[0])cfg.model=names[0];sel.value=cfg.model;save()}function pickModel(x){cfg.model=x;save()}function clearImage(){image=null;$('attach').classList.remove('show')}function grow(x){x.style.height='auto';x.style.height=Math.min(x.scrollHeight,160)+'px'}function keySend(e){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendStop()}}function openSide(){$('side').classList.add('open');$('back').classList.add('show')}function closeSide(){$('side').classList.remove('open');$('back').classList.remove('show')}
function modal(type){let h='';if(type==='settings'){h=`<div class="field"><label>Endereço do Ollama</label><input id="server" value="${esc(cfg.server)}"><div class="hint">Use http://IP-DO-COMPUTADOR:11434. Celular e computador devem estar no mesmo Wi‑Fi.</div></div><div class="field"><label>Modelo</label><select id="setModel"><option value="">Escolha</option>${models.map(x=>{let n=x.name||x.model;return`<option ${n==cfg.model?'selected':''}>${esc(n)}</option>`}).join('')}</select></div><div class="field"><label>Temperatura</label><input id="temp" type="number" min="0" max="1.5" step=".1" value="${cfg.temp}"></div><div class="field"><label>Contexto</label><select id="ctx"><option>2048</option><option ${cfg.ctx==4096?'selected':''}>4096</option><option ${cfg.ctx==8192?'selected':''}>8192</option></select></div><div class="field"><label>Memória pessoal</label><textarea id="memory">${esc(cfg.memory)}</textarea></div><div class="field"><label>Instruções adicionais</label><textarea id="system">${esc(cfg.system)}</textarea></div><div class="row"><button class="btn primary grow" onclick="saveSettings()">Salvar e testar</button></div><p class="hint">Instale o Ollama no computador, baixe um modelo e faça o serviço escutar na rede local em 0.0.0.0:11434. Não exponha essa porta diretamente à internet.</p>`}else if(type==='assist'){h=`<div class="cards">${Object.entries(profiles).map(([id,p])=>`<button class="btn card ${cfg.profile==id?'active':''}" onclick="choose('${id}')"><b>${p[0]}</b><br><span class="hint">${p[1]}</span></button>`).join('')}</div>`}else{h=`<p class="hint">As conversas ficam neste aparelho. Faça backup antes de desinstalar.</p><div class="row"><button class="btn primary grow" onclick="exportData()">Exportar backup</button><button class="btn grow" onclick="V('importBackup')">Importar</button></div><br><button class="btn" style="color:var(--r)" onclick="wipe()">Apagar todos os dados</button>`}$('mtitle').textContent={settings:'Configurações',assist:'Assistentes',data:'Backup e dados'}[type];$('mcontent').innerHTML=h;$('overlay').classList.add('show')}function closeModal(){$('overlay').classList.remove('show')}function saveSettings(){cfg.server=$('server').value.trim();cfg.model=$('setModel').value;cfg.temp=+$('temp').value;cfg.ctx=+$('ctx').value;cfg.memory=$('memory').value.trim();cfg.system=$('system').value.trim();save();closeModal();test()}function choose(id){cfg.profile=id;let c=chat();if(c&&!c.messages.length)c.profile=id;save();closeModal();render()}function exportData(){V('exportBackup','vitao-assistente-backup.json',JSON.stringify({version:1,cfg,chats},null,2))}function importData(s){try{let d=JSON.parse(s);if(!Array.isArray(d.chats))throw 0;if(confirm('Substituir dados atuais?')){chats=d.chats;cfg=Object.assign(cfg,d.cfg||{});active=chats[0]?.id||'';save();render();closeModal()}}catch(e){toast('Backup inválido')}}function wipe(){if(confirm('Apagar tudo?')){chats=[];active='';localStorage.clear();save();render();closeModal()}}window.handleAndroidBack=()=>{if($('overlay').classList.contains('show')){closeModal();return true}if($('side').classList.contains('open')){closeSide();return true}return false};
renderList();render();header();setTimeout(test,500);
</script></body></html>
