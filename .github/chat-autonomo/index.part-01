()">↻</button></header><section class="messages" id="messages"></section><div class="composerWrap"><div class="attach" id="attach"><img id="attachImg"><span class="grow" style="padding:10px">Imagem anexada</span><button class="icon" onclick="clearImage()">×</button></div><div class="composer"><textarea id="prompt" placeholder="Digite uma mensagem…" oninput="grow(this)" onkeydown="keySend(event)"></textarea><div class="tools"><button class="icon" onclick="V('pickImage')">▧</button><button class="icon" onclick="V('voiceInput')">🎙</button><button class="icon" onclick="modal('assist')">✦</button><button class="icon send" id="send" onclick="sendStop()">➤</button></div></div></div></main></div><div class="overlay" id="overlay" onclick="if(event.target===this)closeModal()"><div class="modal"><div class="mh"><h2 id="mtitle"></h2><button class="icon" onclick="closeModal()">×</button></div><div id="mcontent"></div></div></div><div class="toast" id="toast"></div><script>
const $=x=>document.getElementById(x),N=()=>Date.now().toString(36)+Math.random().toString(36).slice(2),esc=s=>String(s||'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const profiles={geral:['Assistente geral','Ajuda ampla, clara e prática.','Você é um assistente pessoal útil, cuidadoso e objetivo. Responda em português do Brasil e não invente fatos.'],acs:['Assistente ACS','Rotina de Agente Comunitário de Saúde.','Ajude um ACS brasileiro com organização, educação em saúde e textos. Não diagnostique; preserve sigilo e indique urgências e protocolos locais.'],renda:['Renda extra','Análise realista de pequenos negócios.','Analise renda extra separando fatos, estimativas e hipóteses. Considere demanda, custos, tempo, riscos, margem e recorrência. Não prometa resultados.'],escrita:['Escrita','Revisão e produção de textos.','Melhore textos em português preservando sentido, clareza, gramática, estrutura e tom. Não invente dados.'],estudo:['Professor','Explicações simples e aprofundadas.','Ensine do simples ao avançado, com analogias, exemplos e pequenas revisões.']};
let cfg=Object.assign({server:'http://192.168.1.2:11434',model:'',temp:.7,ctx:4096,profile:'geral',memory:'',system:''},JSON.parse(localStorage.cfg||'{}')),chats=JSON.parse(localStorage.chats||'[]'),active=localStorage.active||'',models=[],req=null,image=null;
function save(){localStorage.cfg=JSON.stringify(cfg);localStorage.chats=JSON.stringify(chats);localStorage.active=active;renderList();header()}function chat(){return chats.find(x=>x.id===active)}function ensure(){let c=chat();if(!c){c={id:N(),title:'Nova conversa',profile:cfg.profile,messages:[],updated:Date.now()};chats.unshift(c);active=c.id;save()}return c}function V(n,...a){try{if(window.VitaoNative&&typeof VitaoNative[n]=='function'){VitaoNative[n](...a);return 1}}catch(e){}toast('Recurso disponível no APK');return 0}function toast(s){$('toast').textContent=s;$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),2200)}
function renderList(){let q=$('search').value.toLowerCase();$('list').innerHTML=chats.filter(c=>!q||c.title.toLowerCase().includes(q)).sort((a,b)=>b.updated-a.updated).map(c=>`<div class="item ${c.id==active?'active':''}" onclick="selectChat('${c.id}')"><span>${esc(c.title)}</span><button onclick="event.stopPropagation();del('${c.id}')">×</button></div>`).join('')||'<div class="hint" style="padding:15px">Nenhuma conversa.</div>'}function selectChat(id){active=id;save();render();closeSide()}function newChat(){let c={id:N(),title:'Nova conversa',profile:cfg.profile,messages:[],updated:Date.now()};chats.unshift(c);active=c.id;save();render();closeSide()}function del(id){if(confirm('Excluir esta conversa?')){chats=chats.filter(c=>c.id!=id);if(active==id)active=chats[0]?.id||'';save();render()}}function header(){let c=chat(),p=profiles[c?.profile||cfg.profile];$('title').textContent=c?.title||'Nova conversa';$('sub').textContent=p[0]+' • '+(cfg.model||'sem modelo');$('model').value=cfg.model}
function md(s){let x=esc(s),codes=[];x=x.replace(/```([\w+-]*)\n?([\s\S]*?)```/g,(_,l,c)=>{codes.push(`<pre><code>${c}</code></pre>`);return`@@${codes.length-1}@@`});x=x.replace(/^### (.*)$/gm,'<h3>$1</h3>').replace(/^## (.*)$/gm,'<h2>$1</h2>').replace(/^# (.*)$/gm,'<h1>$1</h1>').replace(/\*\*(.*?)\*\*/g,'<b>$1</b>').replace(/`([^`]+)`/g,'<code>$1</code>').replace(/\n/g,'<br>');return x.replace(/@@(\d+)@@/g,(_,i)=>codes[i])}function render(){let c=chat();if(!c||!c.messages.length){$('messages').innerHTML=`<div class="welcome"><div class="logo">V</div><h1>Como posso ajudar?</h1><p>${esc(profiles[c?.profile||cfg.profile][1])} As conversas ficam no aparelho e o modelo roda no seu computador.</p><div class="quick"><button class="btn" onclick="use('Organize minhas prioridades de hoje em um plano prático.')"><b>Organizar o dia</b><br><span class="hint">Transformar tarefas em plano.</span></button><button class="btn" onclick="use('Explique com uma analogia simples e depois aprofunde: ')"><b>Entender um assunto</b><br><span class="hint">Simples primeiro, detalhes depois.</span></button><button class="btn" onclick="use('Revise e melhore este texto: ')"><b>Melhorar texto</b><br><span class="hint">Clareza, gramática e tom.</span></button><button class="btn" onclick="modal('settings')"><b>Conectar ao Ollama</b><br><span class="hint">Configurar servidor e modelo.</span></button></div></div>`;return}$('messages').innerHTML=c.messages.map((m,i)=>`<div class="msg ${m.role}"><div class="avatar">${m.role==='assistant'?'V':'EU'}</div><div><div class="who">${m.role==='assistant'?'Vitão Assistente':'Você'}</div>${m.image?`<img class="pic" src="data:${m.image.mime};base64,${m.image.data}">`:''}<div class="body">${m.pending&&!m.content?'Pensando…':m.role==='assistant'?md(m.content):esc(m.content)}${m.error?`<div style="color:var(--r)">${esc(m.error)}</div>`:''}</div><div class="acts"><button onclick="copy(${i})">Copiar</button>${m.role==='assistant'?`<button onclick="speak(${i})">Ouvir</button><button onclick="regen(${i})">Refazer</button>`:`<button onclick="edit(${i})">Editar</button>`}</div></div></div>`).join('');setTimeout(()=>$('messages').scrollTop=$('messages').scrollHeight,10)}function use(s){$('prompt').value=s;$('prompt').focus();grow($('prompt'))}function copy(i){V('copy',chat().messages[i].content)}function speak(i){V('speak',chat().messages[i].content)}function edit(i){let c=chat();$('prompt').value=c.messages[i].content;c.messages=c.messages.slice(0,i);save();render()}function regen(i){let c=chat(),u=i-1;while(u>=0&&c.messages[u].role!='user')u--;if(u>=0){c.messages=c.messages.slice(0,u+1);go(c)}}
function sendStop(){req?V('stop',req.id):send()}function send(){let text=$('prompt').value.trim();if(!text&&!image)return;if(!cfg.model){toast('Escolha um modelo');modal('settings');return}let c=ensure(),m={id:N(),role:'user',content:text||'Analise esta imagem.',created:Date.now()};if(image)m.image=image;c.messages.push(m);if(c.title==='Nova convers