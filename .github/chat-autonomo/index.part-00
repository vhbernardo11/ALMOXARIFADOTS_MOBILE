<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover"><title>Vitão Assistente</title><style>
:root{--b:#0b0d12;--p:#141821;--p2:#1c2230;--l:#303849;--t:#f6f7fa;--m:#a6afbf;--a:#f4af22;--r:#ff6b6b;--g:#49d49b;color-scheme:dark}*{box-sizing:border-box}html,body{height:100%;margin:0;overflow:hidden;background:var(--b);color:var(--t);font:14px system-ui,-apple-system,"Segoe UI",sans-serif}button,input,textarea,select{font:inherit;color:inherit}.app{height:100%;display:grid;grid-template-columns:270px 1fr}.side{background:var(--p);border-right:1px solid var(--l);padding:16px 10px;display:flex;flex-direction:column;z-index:4}.brand{font-size:18px;font-weight:850;padding:6px 8px 16px}.brand small{display:block;color:var(--m);font-size:11px;margin-top:3px}.btn{border:1px solid var(--l);background:var(--p2);padding:10px;border-radius:12px;cursor:pointer}.primary{background:var(--a);color:#181109;border:0;font-weight:800}.row{display:flex;gap:7px}.grow{flex:1;min-width:0}.search{width:100%;margin:9px 0;background:var(--p2);border:1px solid var(--l);padding:10px;border-radius:11px}.list{overflow:auto;min-height:0}.item{padding:10px;border-radius:11px;display:flex;gap:6px;cursor:pointer}.item.active{background:var(--p2)}.item span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1}.item button{border:0;background:none;color:var(--m)}.foot{margin-top:auto;display:grid;gap:7px;border-top:1px solid var(--l);padding-top:10px}.status{color:var(--m);font-size:12px;padding:6px}.dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:#777;margin-right:6px}.dot.ok{background:var(--g)}.dot.bad{background:var(--r)}main{display:grid;grid-template-rows:auto 1fr auto;min-width:0;position:relative}.top{height:64px;border-bottom:1px solid var(--l);display:flex;align-items:center;gap:8px;padding:8px 14px}.title{font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.sub{font-size:11px;color:var(--m);margin-top:2px}.model{max-width:180px;background:var(--p2);border:1px solid var(--l);padding:9px;border-radius:10px}.messages{overflow:auto;padding:24px max(15px,calc((100vw - 1050px)/2)) 145px}.welcome{text-align:center;max-width:700px;margin:7vh auto}.logo{width:64px;height:64px;margin:auto;border-radius:20px;background:var(--a);color:#171109;display:grid;place-items:center;font-size:28px;font-weight:900}.welcome h1{font-size:36px;margin:18px 0 8px}.welcome p{color:var(--m);line-height:1.5}.quick{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:18px}.quick button{text-align:left;min-height:74px}.msg{max-width:850px;margin:0 auto 23px;display:grid;grid-template-columns:34px 1fr;gap:10px}.avatar{width:34px;height:34px;border-radius:11px;background:var(--p2);display:grid;place-items:center;font-weight:800}.assistant .avatar{background:var(--a);color:#171109}.who{font-weight:800;margin:5px 0 7px}.body{line-height:1.65;overflow-wrap:anywhere}.user .body{white-space:pre-wrap}.body pre{overflow:auto;background:#07090d;padding:12px;border:1px solid var(--l);border-radius:12px}.body code{font-family:monospace;background:var(--p2);padding:2px 5px;border-radius:5px}.body pre code{background:none;padding:0}.acts{margin-top:6px}.acts button{border:0;background:none;color:var(--m);font-size:12px;padding:5px}.pic{max-width:250px;max-height:220px;border-radius:12px}.composerWrap{position:absolute;bottom:0;left:0;right:0;padding:12px max(12px,calc((100vw - 1050px)/2)) calc(12px + env(safe-area-inset-bottom));background:linear-gradient(transparent,var(--b) 23%)}.attach{display:none;max-width:850px;margin:0 auto 6px;background:var(--p);border:1px solid var(--l);padding:7px;border-radius:12px}.attach.show{display:flex}.attach img{width:42px;height:42px;object-fit:cover;border-radius:8px}.composer{max-width:850px;margin:auto;background:var(--p);border:1px solid var(--l);border-radius:18px;padding:8px;box-shadow:0 12px 35px #0007}.composer textarea{width:100%;max-height:160px;resize:none;background:none;border:0;outline:0;padding:8px;min-height:44px}.tools{display:flex;gap:5px;align-items:center}.icon{width:39px;height:39px;border:0;background:none;border-radius:10px;cursor:pointer}.send{margin-left:auto;background:var(--a);color:#171109}.send.stop{background:var(--r);color:#fff}.overlay{display:none;position:fixed;inset:0;background:#000a;z-index:20;align-items:flex-end;justify-content:center;padding:12px}.overlay.show{display:flex}.modal{width:min(650px,100%);max-height:90vh;overflow:auto;background:var(--p);border:1px solid var(--l);border-radius:20px;padding:17px}.mh{display:flex;align-items:center}.mh h2{flex:1;margin:0 0 14px}.field{margin-bottom:13px}.field label{font-weight:750;display:block;margin-bottom:6px}.field input,.field textarea,.field select{width:100%;background:var(--p2);border:1px solid var(--l);padding:10px;border-radius:10px}.field textarea{min-height:80px}.hint{color:var(--m);font-size:12px;line-height:1.4}.cards{display:grid;grid-template-columns:1fr 1fr;gap:8px}.card{text-align:left}.card.active{border-color:var(--a)}.toast{position:fixed;bottom:95px;left:50%;transform:translateX(-50%);background:var(--p2);padding:9px 13px;border-radius:10px;display:none;z-index:30}.toast.show{display:block}.menu{display:none}.back{display:none}@media(max-width:760px){.app{grid-template-columns:1fr}.side{position:fixed;inset:0 auto 0 0;width:85vw;max-width:310px;transform:translateX(-102%);transition:.2s}.side.open{transform:none}.back.show{display:block;position:fixed;inset:0;background:#0008;z-index:3}.menu{display:block}.messages{padding:18px 12px 145px}.quick,.cards{grid-template-columns:1fr}.welcome h1{font-size:29px}.model{max-width:125px}.top{padding-top:calc(8px + env(safe-area-inset-top));height:calc(64px + env(safe-area-inset-top))}}
</style></head><body><div class="app"><aside class="side" id="side"><div class="brand">Vitão Assistente<small>IA local, privada e gratuita</small></div><div class="row"><button class="btn primary grow" onclick="newChat()">＋ Nova conversa</button><button class="btn" onclick="modal('assist')">✦</button></div><input class="search" id="search" placeholder="Buscar conversas" oninput="renderList()"><div class="list" id="list"></div><div class="foot"><div class="status"><i class="dot" id="dot"></i><span id="status">Servidor não testado</span></div><button class="btn" onclick="modal('settings')">⚙ Configurações</button><button class="btn" onclick="modal('data')">⇩ Backup e dados</button></div></aside><div class="back" id="back" onclick="closeSide()"></div><main><header class="top"><button class="btn menu" onclick="openSide()">☰</button><div class="grow"><div class="title" id="title">Nova conversa</div><div class="sub" id="sub">Assistente geral</div></div><select class="model" id="model" onchange="pickModel(this.value)"><option value="">Modelo</option></select><button class="btn" onclick="test